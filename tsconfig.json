{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": false,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"rootDir": "."
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
